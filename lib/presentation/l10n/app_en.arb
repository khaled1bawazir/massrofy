  "@filterSectionDates": {"description": "AC-E5.2 facet."},
  "filterSectionCategories": "Categories",
  "@filterSectionCategories": {"description": "AC-E5.2 facet. Includes Uncategorized as a first-class choice — 'show me what the app could not label' is one of the most useful filters here."},
