  },
  "reviewOutOfWindowConfirmBody": "These messages arrived before {since}, so they were never part of what Massrofy tracks. Their stored text will be deleted and they will not come back. Your recorded transactions are not affected.",
  "@reviewOutOfWindowConfirmBody": {
    "description": "KHA-157 (E) confirmation body. Three facts in the order the user needs them: why these are being removed, that it is permanent, and — the thing they will actually be afraid of — that their transactions are untouched.",
    "placeholders": {"since": {"type": "String", "example": "1 July 2026"}}
  },
  "reviewOutOfWindowConfirmCancel": "Keep them",
  "@reviewOutOfWindowConfirmCancel": {
    "description": "KHA-157 (E) cancel. Positively worded and placed first, mirroring the merge dialog so the two destructive confirmations read as one product."
  },
  "reviewOutOfWindowConfirmAccept": "Discard",
  "@reviewOutOfWindowConfirmAccept": {
    "description": "KHA-157 (E) destructive confirm."
  },
