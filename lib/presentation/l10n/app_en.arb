  "reviewOutOfWindowConfirmTitle": "{count, plural, one{Discard 1 old message?} other{Discard {count} old messages?}}",
  "@reviewOutOfWindowConfirmTitle": {
    "description": "KHA-157 (E) confirmation title. This action really does delete rows — unlike every other exit from this queue — so it asks first, exactly as the duplicate merge does (O-QA-8).",
