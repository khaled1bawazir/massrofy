  "reviewTransferCandidateTitle": "Was this a transfer to your own account?",
  "@reviewTransferCandidateTitle": {"description": "AC-B11.2 review card in S-18. A question, because the app genuinely does not know."},
  "reviewTransferConfirm": "Yes, my own account",
  "@reviewTransferConfirm": {"description": "KHA-78 — writes internal_transfer_state = internal on both legs; the pair leaves spend on the next total."},
  "reviewTransferReject": "No, someone else",
  "@reviewTransferReject": {"description": "KHA-78 — writes external so the detector stops re-proposing this pair."},
