  "reviewOutOfWindowBody": "{count, plural, one{1 message that arrived before {since} was read by mistake. Massrofy only tracks from that date onwards, so it is not part of your spending.} other{{count} messages that arrived before {since} were read by mistake. Massrofy only tracks from that date onwards, so they are not part of your spending.}}",
  "@reviewOutOfWindowBody": {
    "description": "KHA-157 (E). Explains WHY these are here before offering to remove them — 'read by mistake' is the honest cause, and AC-A3.1's window is the reason they do not belong. Housekeeping tone, not a warning: nothing is wrong with the user's data. The date appears once and is referred back to, because the full date form (which carries the year, and the year matters here) is long.",
    "placeholders": {"count": {"type": "int", "example": "424"}, "since": {"type": "String", "example": "1 July 2026"}}
  },
  "reviewOutOfWindowAction": "Discard them",
  "@reviewOutOfWindowAction": {
    "description": "KHA-157 (E) primary action on the banner. Opens a confirmation dialog; it never deletes on the first tap."
