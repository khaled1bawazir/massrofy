  "reviewOutOfWindowTitle": "Messages from before {since}",
  "@reviewOutOfWindowTitle": {
    "description": "KHA-157 (E) banner heading on the Not-understood tab. Names the date so the offer is checkable against the list underneath it, rather than asking the user to trust an unexplained number before a deletion.",
    "placeholders": {"since": {"type": "String", "example": "1 July 2026"}}
