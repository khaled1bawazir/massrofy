{
  "@@locale": "en",

  "appTitle": "Massrofy",
  "@appTitle": {
    "description": "The app name, shown as the wordmark on the lock gate and as the OS task label. Never translated — brand.md §4.4 fixes both the English and Arabic wordmark forms as literals, not a translated string, but it still lives in .arb so every screen references one source of truth."
  },

  "lockGateUnlockToView": "Unlock to view your data",
  "@lockGateUnlockToView": {
    "description": "Lock gate headline shown above the biometric prompt (docs/mockups/lock-gate.html, idle state)."
  },

  "lockGateBiometricHint": "Place your finger on the sensor",
  "@lockGateBiometricHint": {
    "description": "Lock gate subtitle under the biometric icon."
  },

  "lockGateUsePinInstead": "Use PIN instead",
  "@lockGateUsePinInstead": {
    "description": "Link/button offering the PIN fallback when biometrics are available but the user prefers not to use them."
  },

  "lockGateUsePasscode": "Use device passcode instead",
  "@lockGateUsePasscode": {
    "description": "Link/button offering the OS device-credential fallback (BIOMETRIC_STRONG|DEVICE_CREDENTIAL, ADR-005)."
  },

  "lockGateAuthFailed": "Authentication failed. Try again.",
  "@lockGateAuthFailed": {
    "description": "Generic failure banner (ADR-005: the message is deliberately generic, never revealing which factor or why, and never revealing any data)."
  },

  "lockGateEnterPin": "Enter PIN",
  "@lockGateEnterPin": {
    "description": "Headline for the PIN-entry fallback state."
  },

  "lockGateTooManyAttempts": "Too many attempts",
  "@lockGateTooManyAttempts": {
    "description": "Headline for the locked-out state after repeated failed attempts (ADR-005 exponential backoff)."
  },

  "lockGateRetryIn": "Try again in {seconds}, or use PIN",
  "@lockGateRetryIn": {
    "description": "Locked-out countdown message.",
    "placeholders": {
      "seconds": {
        "type": "String",
        "example": "00:28"
      }
    }
  },

  "lockGateSessionExpiredBanner": "Your session ended while the app was in the background. Unlock again to continue where you left off.",
  "@lockGateSessionExpiredBanner": {
    "description": "Banner shown when re-locked after AppLifecycleState.paused past the grace period (ADR-005 re-lock policy)."
  },

  "lockGateContinueUnlock": "Unlock to continue",
  "@lockGateContinueUnlock": {
    "description": "Headline shown together with the session-expired banner."
  },

  "lockGateUnlockButtonSemanticLabel": "Unlock with biometrics",
  "@lockGateUnlockButtonSemanticLabel": {
    "description": "Screen-reader label for the biometric icon/button (NFR-U2)."
  },

  "homePlaceholderTitle": "Home",
  "@homePlaceholderTitle": {
    "description": "Placeholder home screen shown after unlock in this P1 foundation build; replaced by the real dashboard (S-08) in a later phase."
  },

  "homePlaceholderBody": "This is the Massrofy foundation build. SMS ingestion, categorisation, and reporting are built in later phases — this screen only proves the app launches, unlocks, and reads/writes its encrypted store correctly.",
  "@homePlaceholderBody": {
    "description": "Explanatory copy for the placeholder home screen."
  },

  "smsRationaleTitle": "Why Massrofy needs SMS access",
  "@smsRationaleTitle": {
    "description": "S-02 headline (docs/mockups/onboarding.html). Shown BEFORE the OS permission dialog — design flag D-9, AC-A1.2."
  },

  "smsRationaleLead": "Your bank sends transaction alerts by SMS. Massrofy reads only those messages, on your device, to build a picture of your spending.",
  "@smsRationaleLead": {
    "description": "S-02 explanation card body."
  },

  "smsRationalePointOnDevice": "Everything is processed on your phone",
  "@smsRationalePointOnDevice": {
    "description": "S-02 guarantee bullet 1. Backed by ADR-001: the release build declares no INTERNET permission, so this is an OS-enforced property, not a promise."
  },

  "smsRationalePointNoSharing": "No data is sent to us or to anyone else",
  "@smsRationalePointNoSharing": {
    "description": "S-02 guarantee bullet 2 (AC-F4.2)."
  },

  "smsRationalePointRevocable": "You can revoke access at any time",
  "@smsRationalePointRevocable": {
    "description": "S-02 guarantee bullet 3."
  },

  "smsRationalePointNoiseIgnored": "Non-financial messages are ignored and never stored",
  "@smsRationalePointNoiseIgnored": {
    "description": "S-02 guarantee bullet 4. This is literally true per NFR-P4: a message from an unrecognised sender produces no database row at all."
  },

  "smsRationaleGrant": "Grant SMS access",
  "@smsRationaleGrant": {
    "description": "S-02 primary CTA — opens the OS permission dialog."
  },

  "smsRationaleNotNow": "Not now",
  "@smsRationaleNotNow": {
    "description": "S-02 secondary CTA. Declining leads to S-04 limited mode, never to a dead end."
  },

  "smsLimitedModeTitle": "Limited mode is on",
  "@smsLimitedModeTitle": {
    "description": "S-04 headline. Covers both permission-declined and permission-revoked (AC-A1.2, AC-A1.3)."
  },

  "smsLimitedModeBody": "Without SMS access, transactions will not be added automatically. Any data you already have is still intact, and you can add transactions manually at any time.",
  "@smsLimitedModeBody": {
    "description": "S-04 body. The 'already have is still intact' half is required by AC-A1.3 — a user who fears their history is gone may reinstall, which would actually destroy it."
  },

  "smsLimitedModeOpenSettings": "Open system settings",
  "@smsLimitedModeOpenSettings": {
    "description": "S-04 primary CTA when the permission is permanently denied — the OS silently no-ops a re-request, so a deep link is the only honest offer."
  },

  "smsLimitedModeTryAgain": "Grant SMS access",
  "@smsLimitedModeTryAgain": {
    "description": "S-04 primary CTA when the permission was merely declined and the OS dialog will still appear."
  },

  "smsLimitedModeAddManually": "Add a transaction manually",
  "@smsLimitedModeAddManually": {
    "description": "S-04 fallback CTA — the app must never be a dead end (AC-A1.2)."
  },

  "smsRevokedBannerTitle": "SMS access was turned off",
  "@smsRevokedBannerTitle": {
    "description": "AC-A1.3 persistent banner shown on Home when access was granted and later revoked — including by Android 11+'s automatic permission reset for unused apps."
  },

  "importProgressTitle": "Importing your messages",
  "@importProgressTitle": {
    "description": "S-05 headline (AC-A3.2)."
  },

  "importProgressFound": "{count} transactions found so far…",
  "@importProgressFound": {
    "description": "S-05 live count.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "41"
      }
    }
  },

  "importProgressContinueInBackground": "Continue in the background",
  "@importProgressContinueInBackground": {
    "description": "S-05 dismiss action. The import is non-blocking per NFR-R2/AC-A3.2 — the user is never trapped on this screen."
  },

  "importProgressScopeNote": "Massrofy imports messages from the start of this month.",
  "@importProgressScopeNote": {
    "description": "Sets the expectation set by AC-A3.1 (OQ-11 resolved: current calendar month, not full history) so an empty-looking result is not mistaken for a failure."
  },

